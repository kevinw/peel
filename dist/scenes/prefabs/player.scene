[1]
scene "Player Prefab" {
  asset "runner_lizard" {
    model "./models/Lizard run.glb"
  }

  node "PlayerBody" {
    position 0 0 0
    rotation_deg 0 0 0
    scale 4.8 4.8 4.8
    skinned_mesh_render "runner_lizard"
    clip "Run"
    behavior "Player_Controller" {
      autopilot false
      move_speed 4.15
    }
  }
}
