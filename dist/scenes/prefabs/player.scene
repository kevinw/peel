[1]
scene "Player Prefab" {
  asset "player_character" {
    model "./models/character/character.glb"
  }

  node "PlayerBody" {
    position 0 0 0
    rotation_deg 0 0 0
    scale 100.8 100.8 100.8
    skinned_mesh_render "player_character"
    clip "walk"
    behavior "Player_Controller" {
      autopilot false
      move_speed 4.15
    }
  }
}
